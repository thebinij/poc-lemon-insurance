# Lambda Environment Configuration for LocalStack

# AWS Configuration
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# LocalStack Endpoint
AWS_ENDPOINT=http://localhost:4566

# SQS Configuration
SQS_QUEUE_URL=http://localhost:4566/000000000000/insurance-events

# Parse Server Configuration
PARSE_APP_ID=lemon-insurance-app-id
PARSE_JS_KEY=lemon-insurance-js-key
PARSE_MASTER_KEY=lemon-insurance-master-key
PARSE_SERVER_URL=http://localhost:1337/parse

# MongoDB Configuration (if needed)
MONGODB_URI=mongodb://localhost:27017/lemon-insurance

# Logging
NODE_ENV=development
LOG_LEVEL=debug
