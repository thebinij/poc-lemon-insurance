meta {
  name: Parse Server Workflows
  type: http
  seq: 9
}

get {
  url: {{parseUrl}}/parse/classes/Workflow
  body: none
  auth: basic
}

headers {
  X-Parse-Application-Id: {{parseAppId}}
  X-Parse-Master-Key: {{parseMasterKey}}
}

docs {
  description: Get all workflows from Parse Server
  request: Requires Parse Server application ID and master key
  response: Returns list of all workflow records
  notes: This endpoint shows workflow records created by Lambda functions
}
