
# SERVER CONFIGURATION
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# MONGODB CONFIGURATION
MONGODB_URI=mongodb://admin:password@localhost:27017/lemon-insurance?authSource=admin

# PARSE SERVER CONFIGURATION
PARSE_APP_ID=lemon-insurance-app-id
PARSE_MASTER_KEY=lemon-insurance-master-key
PARSE_JS_KEY=lemon-insurance-js-key
PARSE_SERVER_URL=http://localhost:1337/parse
PARSE_PUBLIC_SERVER_URL=http://localhost:4040

# AWS CONFIGURATION
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT=http://localhost:4566


USE_LOCALSTACK=true
SQS_QUEUE_URL=http://localhost:4566/000000000000/auth-events


# LOGGING CONFIGURATION
LOG_FORMAT=combined
LOG_COLORIZE=true
LOG_LEVEL_FILE=info
LOG_LEVEL_CONSOLE=debug

# PERFORMANCE CONFIGURATION
MAX_REQUEST_SIZE=10mb
REQUEST_TIMEOUT=30000
KEEP_ALIVE_TIMEOUT=65000

# CORS CONFIGURATION
CORS_ORIGIN=http://localhost:3000
CORS_CREDENTIALS=true
CORS_MAX_AGE=86400

# RATE LIMITING CONFIGURATION
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# HEALTH CHECK CONFIGURATION
HEALTH_CHECK_INTERVAL=30000
HEALTH_CHECK_TIMEOUT=5000
HEALTH_CHECK_RETRIES=3

# QUEUE CONFIGURATION
SQS_VISIBILITY_TIMEOUT=30
SQS_MESSAGE_RETENTION_PERIOD=1209600
SQS_MAX_RECEIVE_COUNT=3

# PARSE SERVER ADVANCED CONFIGURATION
PARSE_SERVER_VERBOSE=true
PARSE_SERVER_ALLOW_CLIENT_CLASS_CREATION=false
PARSE_SERVER_ALLOW_CUSTOM_OBJECT_ID=false
PARSE_SERVER_ENABLE_ANONYMOUS_USERS=false
PARSE_SERVER_LIVE_QUERY_CLASSES=User,AuthEvent,Workflow

# FILE STORAGE CONFIGURATION
PARSE_SERVER_FILES_SUBDIRECTORY=files
PARSE_SERVER_MAX_FILE_SIZE=100mb
PARSE_SERVER_FILE_EXTENSIONS=jpg,jpeg,png,gif,pdf,doc,docx

# DATABASE CONNECTION POOLING
MONGODB_MAX_POOL_SIZE=10
MONGODB_MIN_POOL_SIZE=2
MONGODB_MAX_IDLE_TIME_MS=30000
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

# API VERSIONING
API_VERSION=v1
API_PREFIX=/api
ENABLE_API_VERSIONING=true
